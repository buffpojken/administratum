# Copy to ~/codeartifact-env.sh so it works from any project.
#
# Fetches a CodeArtifact token (valid 12h) for an AWS profile and exports it, so Bundler,
# `docker build --secret` and Kamal builds can use it.
#
#   source ~/codeartifact-env.sh <aws-profile>          # exports into the current shell
#   eval "$(~/codeartifact-env.sh <aws-profile>)"       # same, when run as a command
#
# Exports:
#   CODEARTIFACT_AUTH_TOKEN   the raw token
#   BUNDLE_<HOST>             "aws:<token>", which Bundler reads as credentials for the repo
#
# Defaults point at the greyseal domain; override with CODEARTIFACT_DOMAIN, CODEARTIFACT_OWNER
# and CODEARTIFACT_REGION. The profile must be an IAM user or role: AWS refuses tokens to root.

_codeartifact_env() {
  local profile="$1"
  local domain="${CODEARTIFACT_DOMAIN:-greyseal}"
  local owner="${CODEARTIFACT_OWNER:-791515923336}"
  local region="${CODEARTIFACT_REGION:-eu-north-1}"

  if [ -z "$profile" ]; then
    echo "usage: source ~/codeartifact-env.sh <aws-profile>" >&2
    return 1
  fi

  local token
  token=$(aws codeartifact get-authorization-token --domain "$domain" --domain-owner "$owner" \
    --region "$region" --profile "$profile" --query authorizationToken --output text) || return 1

  # Bundler's env name for a host: uppercase, "." -> "__", "-" -> "___".
  local host="$domain-$owner.d.codeartifact.$region.amazonaws.com"
  local bundle_var
  bundle_var="BUNDLE_$(printf '%s' "$host" | tr '[:lower:]' '[:upper:]' | sed -e 's/-/___/g' -e 's/\./__/g')"

  printf 'export CODEARTIFACT_AUTH_TOKEN=%s\n' "$token"
  printf 'export %s=%s\n' "$bundle_var" "aws:$token"
}

if (return 0 2>/dev/null); then
  # Sourced: export into the caller's shell.
  if _codeartifact_env_out=$(_codeartifact_env "$@"); then
    eval "$_codeartifact_env_out"
    echo "CodeArtifact token for profile '$1' exported (valid 12h)." >&2
  fi
  unset _codeartifact_env_out
  unset -f _codeartifact_env
else
  # Executed: print export lines for eval.
  _codeartifact_env "$@" || exit 1
fi
