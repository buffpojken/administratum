<% reorderable = index_reorderable? %>
<section class="adm-card">
  <div class="adm-table-wrap">
    <table class="adm-table">
      <thead>
        <tr>
          <% if reorderable %>
            <th scope="col" class="w-px whitespace-nowrap"><%= t("administratum.reorder.column") %></th>
          <% end %>
          <% definition.index_columns.each do |column| %>
            <th scope="col"><%= column.sortable ? sort_link(@search, column.name, column_label(column)) : column_label(column) %></th>
          <% end %>
          <th scope="col" class="adm-table-actions"><span class="adm-sr-only"><%= t("administratum.actions.title") %></span></th>
        </tr>
      </thead>
      <tbody<% if reorderable %> data-adm-sortable<% end %>>
        <% @resources.each do |record| %>
          <tr<% if reorderable %> data-adm-sortable-item<% end %>>
            <% if reorderable %>
              <td class="w-px whitespace-nowrap"><%= reorder_controls record, form: "adm-reorder", column: definition.reorder_column %></td>
            <% end %>
            <% definition.index_columns.each_with_index do |column, index| %>
              <td>
                <% if index.zero? && !column.block && definition.action_enabled?(:show) %>
                  <%= link_to column_value(record, column), resource_path(record), class: "adm-link" %>
                <% else %>
                  <%= column_value(record, column) %>
                <% end %>
              </td>
            <% end %>
            <td class="adm-table-actions"><div class="adm-btn-group"><%= buttons_for(:row, record) %></div></td>
          </tr>
        <% end %>
        <% if @resources.empty? %>
          <tr><td colspan="<%= definition.index_columns.size + (reorderable ? 2 : 1) %>" class="adm-empty"><%= t("administratum.empty", resources: resource_class.plural_label.downcase) %></td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <footer class="adm-card-footer adm-table-footer">
    <div class="adm-muted">
      <%== pagy_info(@pagy) %>
      <% if definition.csv %>
        · <%= link_to t("administratum.download_csv"), url_for(format: :csv, q: request.query_parameters[:q], scope: current_index_scope&.name), class: "adm-link" %>
      <% end %>
    </div>
    <% if reorderable %>
      <div class="adm-form-footer">
        <%= reorder_form id: "adm-reorder", url: action_path(:reorder) %>
        <%= reorder_save_button form: "adm-reorder", class: "adm-btn-sm" %>
      </div>
    <% end %>
    <div class="adm-pagy"><%== pagy_nav(@pagy) if @pagy.pages > 1 %></div>
  </footer>
</section>
