<% content_for :title, t("administratum.password_resets.new_password") %>
<h1 class="adm-auth-title"><%= t("administratum.password_resets.new_password") %></h1>
<% if @errors.present? %>
  <div class="adm-alert" role="alert"><ul><% @errors.each do |message| %><li><%= message %></li><% end %></ul></div>
<% end %>
<%= form_with url: administratum.password_reset_path, method: :patch, class: "adm-form" do |f| %>
  <%= f.hidden_field :token, value: @token %>
  <div class="adm-field">
    <%= f.label :password, t("administratum.sessions.password"), class: "adm-label" %>
    <%= f.password_field :password, class: "adm-input", required: true, autofocus: true, autocomplete: "new-password" %>
  </div>
  <div class="adm-field">
    <%= f.label :password_confirmation, t("administratum.password_resets.confirmation"), class: "adm-label" %>
    <%= f.password_field :password_confirmation, class: "adm-input", required: true, autocomplete: "new-password" %>
  </div>
  <%= f.submit t("administratum.password_resets.save"), class: "adm-btn adm-btn-primary adm-btn-block" %>
<% end %>
